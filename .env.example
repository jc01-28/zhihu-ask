# ── 知乎 OAuth（第三方登录，代表用户访问其关注/收藏）──────────────────
# app_id / app_key 向 product-platform@zhihu.com 申请，回调必须是公网 HTTPS
ZHIHU_APP_ID=
ZHIHU_APP_KEY=
ZHIHU_REDIRECT_URI=https://your-domain.example/api/oauth/callback

# ── 知乎开放平台 Access Secret（调用方鉴权，所有内容接口都要）──────────
# 在 https://developer.zhihu.com/profile 生成
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE=https://developer.zhihu.com

# ── 会话加密密钥（保存 OAuth token 的 HttpOnly Cookie 用它加解密）──────
# 生成：openssl rand -hex 32
SESSION_SECRET=

# ── LLM ────────────────────────────────────────────────────────────────
# zhida  = 知乎直答（OpenAI 兼容，额度 100 次/天）
# openai = 任意 OpenAI 兼容服务
# none   = 全走启发式降级，不调 LLM
LLM_PROVIDER=zhida
LLM_MODEL=zhida-fast-1p5
LLM_API_KEY=
LLM_BASE_URL=

# ── 接口额度护栏（每日上限，防止把额度烧穿）────────────────────────────
QUOTA_ZHIHU_SEARCH=1000
QUOTA_GLOBAL_SEARCH=1000
QUOTA_HOT_LIST=100
QUOTA_ZHIDA=100

# ── 缓存 TTL（毫秒）。演示前预热一次，现场就完全不依赖实时网络 ───────────
CACHE_TTL_MS=86400000

# ── 缓存/产物的存放根目录 ──────────────────────────────────────────────
# 留空则自动探测：DATA_DIR → process.cwd() → os.tmpdir()
# ⚠️ serverless（Vercel）上 cwd 只读，会自动回退到 /tmp，无需手工配置
DATA_DIR=

# ── /api/ask 的进程内限流（保险丝，防演示期间额度被烧穿）──────────────
# 10 分钟 20 次/客户端。设为 0 关闭。注意它不是全局配额，多实例各算各的
ASK_RATE_LIMIT=20
ASK_RATE_WINDOW_MS=600000

# ── 1 = 用本地 fixture 数据源，无需任何凭证即可跑通全链路 ────────────────
USE_FIXTURES=0
