# live 联调模式（`pnpm dev --mode live`）。
#
# 与 mock 的区别只有一处：前端不再内置假数据，全部请求打到相对路径 /api 与
# /auth，再由开发服务器代理到 `VITE_DEV_PROXY_TARGET`。
#
# 没有真实后端时，可以用仓库里的桩服务器把整条链路跑通：
#   node scripts/live-stub-server.mjs &
#   pnpm dev --mode live
#
# 想接自己的后端：把它跑在 8787，或者改下面这行。个人覆盖写进 `.env.local`
# （已被 .gitignore 忽略），不要改这个文件。
VITE_API_MODE=live
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787

# 「用户视角 / 答主视角」是 Mock 后端专有的演示开关，live 模式下一律关掉。
VITE_ENABLE_DEMO_ROLE_SWITCHER=false
