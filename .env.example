# ══════════════════════════════════════════════════════════════════════
#  知乎需要「三个」不同的凭证，它们很容易混淆：
#
#   App ID        ─ 短数字（如 451），标识应用，进配置
#   OAuth App Key ─ 后端换 access_token 用，只放服务端
#   Access Secret ─ 开放平台调用方鉴权，**所有用户数据接口都要**
#                   在 https://developer.zhihu.com/profile 生成
#
#  ⚠️ Access Secret ≠ OAuth App Key。把 App Key 当 Access Secret 用，
#     用户数据接口一定 401，而报错信息不会告诉你是这个原因。
# ══════════════════════════════════════════════════════════════════════

# ── 知乎 OAuth（第三方登录，代表用户访问其关注/收藏）──────────────────
ZHIHU_APP_ID=
# 官方模板用 ZHIHU_OAUTH_APP_KEY 命名以避免歧义（也兼容 ZHIHU_APP_KEY）
ZHIHU_OAUTH_APP_KEY=
# 必须与开放平台登记的地址逐字符一致，且必须是公网 HTTPS。
# localhost / 127.0.0.1 只能预览页面，无法完成真实登录 —— 平台限制，不是配置问题。
ZHIHU_REDIRECT_URI=https://your-domain.example/api/auth/zhihu/callback
# 是否强制要求回调回传 state（默认 0）。
# 知乎当前**不保证**回传 state，设为 1 会让所有人都登不进去，除非你先实测确认它回传了。
# 注意：state_mismatch（带了但对不上）无视这个开关，永远拒绝 —— 那是真正的 CSRF 防护。
ZHIHU_REQUIRE_STATE=0

# ── 对外链接（项目推荐页 `/` 上的两个按钮）──────────────────────────────
# ⚠️ 必须是 NEXT_PUBLIC_ 前缀。规格里写的是 VITE_GITHUB_URL / VITE_LIVE_SITE_URL，
#    那是 Vite 的约定，Next.js **不会**把 VITE_* 注入到浏览器。
NEXT_PUBLIC_GITHUB_URL=https://github.com/jc01-28/zhihu-ask
# 留空则「进入在线网站」跳本应用的 /app
NEXT_PUBLIC_LIVE_SITE_URL=

# ── 知乎开放平台 Access Secret（调用方鉴权）───────────────────────────
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE=https://developer.zhihu.com
# 读当前用户资料用的是这个域名（与内容接口不同），一般不用改
ZHIHU_OPENAPI_BASE=https://openapi.zhihu.com

# ── 会话加密密钥（保存 OAuth token 的 HttpOnly Cookie 用它加解密）──────
# 生成：openssl rand -hex 32
SESSION_SECRET=

# ── LLM ────────────────────────────────────────────────────────────────
# openai = 任意 OpenAI 兼容服务（推荐，免费额度好拿）
# zhida  = 知乎直答（同样 OpenAI 兼容，但用 Access Secret 鉴权，100 次/天）
# none   = 全走启发式降级，不调 LLM（跑集成测试用）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.8-flash-lite

# 抽取步骤会对每条内容各调一次模型。实测轻量推理模型单次要 10~30 秒，
# 串行会撞上 route handler 的 maxDuration，所以默认并发 4。
# 模型快可以调高；撞上游限流就调低。
LLM_CONCURRENCY=4

# ── 出站请求超时（毫秒）────────────────────────────────────────────────
# ⚠️ 必须设。没有超时的 fetch 在 provider 不响应时会让整条链路永久卡住，
#    而 optional / 降级逻辑只在 promise reject 时才生效。
#    实测踩过：一次抽取调用挂死 300 秒，请求一直不返回。
LLM_TIMEOUT_MS=30000
ZHIHU_TIMEOUT_MS=15000

# ── 经历抽取 ───────────────────────────────────────────────────────────
# per-hit = 每条内容各调一次（默认）。实测比 batch 更快**且**抽得更全
# batch   = 一次调用处理全部内容。实测在同一模型上更慢、漏抽更多，仅作备选
EXTRACT_MODE=per-hit
# 每次最多抽几条。并发 4 + 4 条 = 1 波调用，是压住 maxDuration=60s 的关键杠杆。
# 调高会线性增加该步耗时；调低可能召回不到足够的候选。
# ⚠️ 实验配置（src/domain/experiment.ts）会覆盖这个值：A/B 组不抽取，C 组用 4。
EXTRACT_MAX_HITS=4

# ── 语义召回（Embedding）─────────────────────────────────────────────────
# ⚠️ 默认**不配置**，此时语义侧降级为 hash 投影（只看词元重合度）。
#    降级不会报错、链路照常跑，但结论**不能**当作「语义召回的能力」。
#
# 要启用真语义召回，三个变量必须**同时**配全（缺一个就降级，不会半残运行）：
#
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
#
# 为什么不做「自动复用 LLM_* 凭证」：实测踩过 ——
# SenseNova 的 LLM_BASE_URL 没有 /embeddings 端点，自动复用会让 B/C 组
# 直接 404 崩掉整条请求链路。「OpenAI 兼容的 chat 端点」不等于「有 embeddings 端点」，
# 这件事必须由人显式确认。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ── 接口额度护栏（每日上限，防止把额度烧穿）────────────────────────────
QUOTA_ZHIHU_SEARCH=1000
QUOTA_GLOBAL_SEARCH=1000
QUOTA_HOT_LIST=100
QUOTA_ZHIDA=100
QUOTA_OPENAI=1000
QUOTA_USER_API=500

# ── 缓存 TTL（毫秒）。演示前预热一次，现场就完全不依赖实时网络 ───────────
CACHE_TTL_MS=86400000

# ── 缓存/产物的存放根目录 ──────────────────────────────────────────────
# 留空则自动探测：DATA_DIR → process.cwd() → os.tmpdir()
# ⚠️ serverless（Vercel）上 cwd 只读，会自动回退到 /tmp，无需手工配置
DATA_DIR=

# ── /api/ask 的进程内限流（保险丝，防演示期间额度被烧穿）──────────────
# 10 分钟 20 次/客户端。设为 0 关闭（集成测试会自动关）。多实例各算各的
ASK_RATE_LIMIT=20
ASK_RATE_WINDOW_MS=600000

# ── 1 = 用本地 fixture 数据源，无需任何凭证即可跑通全链路 ────────────────
USE_FIXTURES=0

# ── fixture 模式下用哪份语料（仅 USE_FIXTURES=1 时生效）─────────────────
#   all       = 三份都要（默认，向后兼容）
#   synthetic = 只要虚构语料（sample 6 条 + gold 168 条）。评测/对照实验用 ——
#               gold 的 ground truth 标签只对合成语料有效，混入真实语料会让指标失真
#   real      = 只要真实语料（harvested-hits.json）。**产品演示用** ——
#               界面上不该出现「林一舟」这类虚构作者
# ⚠️ npm run eval / npm run e2e 会各自钉死为 synthetic，不受这里影响
FIXTURE_CORPUS=all
