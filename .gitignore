# ══════════════════════════════════════════════════════════════════════
#  发布范围约定
#
#  ✅ 会发布：README / DEVELOPER / AGENT、src/、scripts/、eval/、配置、.env.example
#  ❌ 不发布：internal/（团队内部资料）、凭证、缓存与构建产物
#
#  ⚠️ 采用「目录级」忽略，而不是「文件级」——
#     以后往 internal/ 里新增内部文档不需要改这个文件，
#     也就不会因为漏加一条规则而把内部资料传到公开仓库。
#
#  提交前跑一次 `npm run publish:check` 自检。
# ══════════════════════════════════════════════════════════════════════

# ── src/ 的分层与发布范围 ───────────────────────────────────────────────
#   src/app/     Next.js 路由壳            → 发布
#   src/back/    后端：steps/domain/framework/adapters/handlers        → 发布
#   src/back/fixtures/  语料                → 发布（离线演示必需，见下方保护规则）
#   src/front/   前端：pages/components/api-client/styles              → 发布
#   src/shared/  前后端契约 contract.ts     → 发布
#
#   只有「运行时才生成」的东西才忽略：.cache/ 与 .artifacts/（见下）。

# ── 依赖 ───────────────────────────────────────────────────────────────
node_modules/

# ── 构建产物 ───────────────────────────────────────────────────────────
.next/
out/
build/
dist/
dev-dist/
*.tsbuildinfo
next-env.d.ts

# ── 运行时产物：缓存（保护 API 配额）与流水线 trace ─────────────────────
#  ⚠️ 注意：src/back/fixtures/ 下的 json 是**输入语料**，不是运行时产物 ——
#     绝对不要用 `*.json` 这类通配规则把它扫进来。
.cache/
.artifacts/
.vite/
.turbo/

# ── 内部资料：不随仓库发布 ─────────────────────────────────────────────
# 交接说明、进度排期、团队内部决策记录等。
# 这些是写给团队自己看的（含第二人称、排期、内部判断），
# 公开仓库只需要展示产品与工程本身。
internal/

# ── 输入语料：**必须提交**（下面只是提醒，不是忽略规则）────────────────
#   src/back/fixtures/sample-hits.json     手写种子语料（6 条）
#   src/back/fixtures/gold-hits.json       合成 Golden Dataset（168 条，对照实验用）
#   src/back/fixtures/harvested-hits.json  harvest 抓的真实知乎内容（80 条，产品演示用）
#
#   前两个让评测可复现，第三个让离线演示有真材实料 —— 缺任何一个，
#   别人 clone 下来都跑不出报告里的数字。所以**不要**加 `*.json` 之类的通配忽略。

# ── 凭证：任何情况下都不要提交 ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.local
!.env.example

# ── 测试与覆盖率产物 ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ── 杂项 ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
.eslintcache
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.tmp
*.temp

# 本地助手工具的工作目录，不属于工程源码
.workbuddy/

.vercel
.env*

# 工具写权限探针，非工程文件
.write-probe
