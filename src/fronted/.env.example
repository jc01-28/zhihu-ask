# ---- 运行模式 ----
# mock：不访问任何后端，使用确定性 Mock API 独立运行全部页面。
# live：只请求相对路径 /api 与 /auth，由开发服务器代理或同源后端处理。
VITE_API_MODE=mock

# 仅 live 模式生效。默认留空表示同源相对路径。
# 生产环境不允许配置成跨站 Cookie 域名，否则浏览器不会带上会话 Cookie。
VITE_API_BASE_URL=

# Mock 模式的初始登录态：authenticated | anonymous | unconfigured
VITE_MOCK_AUTH_STATE=authenticated

# 是否显示「用户视角 / 答主视角」演示切换。真实环境应设为 false。
VITE_ENABLE_DEMO_ROLE_SWITCHER=true

# 开发服务器把 /api、/auth 代理到该地址（仅 vite dev 使用）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787

# ---- 项目推荐页（/）----
# GitHub 地址。**留空即为未配置**，按钮会显示「GitHub 地址暂未配置」的禁用态，
# 而不是生成一个指向别处的死链接。下面这行是占位示例，取消注释也不会生效，
# 需要替换成真实仓库地址。
# VITE_GITHUB_URL=https://github.com/example/zhihu-wenren
VITE_GITHUB_URL=

# 「进入在线网站」的地址。默认 /app 表示本站的功能首页；
# 也可以配置成外部的 https 地址（会自动按新标签外链打开）。
VITE_LIVE_SITE_URL=/app
